# Copy this file to .env and fill in your values. .env is gitignored, so
# it's safe to put real credentials in it. Loaded automatically by `make run`.

# Required
IMMICH_URL=http://192.168.1.10:2283
IMMICH_API_KEY=your-api-key

# Optional (defaults shown, uncomment to override)
# LISTEN_ADDR=:8200
# FRIENDLY_NAME=Immich Photos
# DEVICE_UUID=3e7f0f4e-8c2e-4f7a-9c2a-immichdlna01
# SSDP_INTERFACE=eth0
# CACHE_DIR=/config/cache
# CACHE_MAX_MB=2048
# DISABLE_CACHE=false
# MAX_RESOLUTION=1920x1080
